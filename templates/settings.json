{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "Bash(rm -rf /)", "Bash(rm -rf ~)", "Bash(sudo *)",
      "Read(.env*)", "Read(**/credentials*)", "Read(**/*secret*)"
    ]
  },
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/pre-compact-save.sh",
            "timeout": 10000
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-start-restore.sh",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/check-failed-attempts.sh",
            "timeout": 5000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-quality.sh",
            "timeout": 30000
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/stop-cost-summary.sh",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/stop-learning-capture.sh",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/audit-review.sh",
            "timeout": 10000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-audit.sh",
            "timeout": 3000
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-decay-counter.sh",
            "timeout": 3000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-claudemd-size.sh",
            "timeout": 10000
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/check-config-protection.sh",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/check-loop-breaker.sh",
            "timeout": 3000
          }
        ]
      }
    ]
  }
}
